{
	"name": "l-meetscribe",
	"version": "0.1.0",
	"private": true,
	"description": "Obsidian plugin that records meetings, transcribes them locally, and summarizes the transcript.",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": "^24.0.0"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"build:native": "bash scripts/build-native.sh"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "24.19.2",
		"esbuild": "0.28.2",
		"eslint": "10.13.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"obsidian": "1.11.4",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vitest": "5.0.5"
	}
}
